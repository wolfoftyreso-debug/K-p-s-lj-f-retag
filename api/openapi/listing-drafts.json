            "type": "string",
            "description": "Normalized maximum 160 Unicode code points."
          },
          "description": {
            "type": "string",
            "description": "Normalized maximum 8000 Unicode code points; LF and TAB permitted."
          },
          "sale_subject": {
            "type": "string",
            "enum": [
              "",
              "legal_entity",
              "operating_business",
              "business_division",
              "asset_package"
            ]
          },
          "transfer_structure": {
            "type": "string",
            "enum": [
              "",
              "share_sale",
              "business_transfer"
            ]
          },
          "sale_context": {
            "type": "string",
            "enum": [
              "",
              "ordinary_sale",
              "succession",
              "restructuring",
              "insolvency",
              "other"
            ]
          },
          "sale_method": {
            "type": "string",
            "enum": [
              "",
              "asking_price",
              "negotiation",
              "invitation_for_offers",
              "time_limited_bidding"
            ]
          }
        },
        "required": [
          "expected_business_version",
          "expected_listing_version"
        ]
      },
      "CreatedDraft": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workspace_id": {
