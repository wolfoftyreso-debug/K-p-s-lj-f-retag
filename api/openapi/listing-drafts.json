          "error"
        ]
      },
      "CreateDraft": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "private_label": {
            "type": "string",
            "description": "Private working label. Normalized maximum 120 Unicode code points; omitted or empty means unset."
          },
          "activity_description": {
            "type": "string",
            "description": "Business activity, separate from listing presentation. Normalized maximum 2000 Unicode code points."
          },
          "country": {
            "type": "string",
            "description": "Optional two ASCII letters, normalized to uppercase. Format validation does not establish country eligibility or launch markets."
          },
          "region": {
            "type": "string",
            "description": "Optional region text. Normalized maximum 120 Unicode code points."
          },
          "title": {
            "type": "string",
            "description": "Normalized maximum 160 Unicode code points."
          },
          "description": {
            "type": "string",
            "description": "Normalized maximum 8000 Unicode code points; LF and TAB permitted."
          },
          "sale_subject": {
            "type": "string",
            "enum": [
              "",
              "legal_entity",
              "operating_business",
              "business_division",
              "asset_package"
            ]
          },
          "transfer_structure": {
            "type": "string",
            "enum": [
              "",
              "share_sale",
              "business_transfer"
            ]
          },
          "sale_context": {
            "type": "string",
            "enum": [
              "",
              "ordinary_sale",
              "succession",
              "restructuring",
              "insolvency",
              "other"
            ]
          },
          "sale_method": {
            "type": "string",
            "enum": [
              "",
              "asking_price",
              "negotiation",
              "invitation_for_offers",
              "time_limited_bidding"
            ]
          }
        },
        "required": [
          "command_id"
        ]
      },
