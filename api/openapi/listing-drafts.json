{
  "openapi": "3.1.0",
  "info": {
    "title": "Private Business and Listing Draft API",
    "version": "1.0.0",
    "description": "Approved private drafting slice. All endpoints require a current human session and current server-owned workspace permissions. No public listing, upload, verification or publication workflow exists. All query parameters are rejected. Mutations require exact Origin and CSRF proof; ambiguous cookies or Authorization credentials are rejected. Optional strings may be absent or empty; null, unknown/case-alias/duplicate keys and malformed Unicode are rejected. The bounded HTTP body limit is explicit runtime configuration. Return codes 404 do not distinguish absent from inaccessible resources. A 503 after mutation is an uncertain outcome: retry creation with the original command_id, reconcile PUT using GET and source versions. UUID identifiers are canonical lowercase strings. The default body limit is 128KiB, sufficient for all maximum field lengths including JSON surrogate-pair escapes; a lower configured bound may reject otherwise valid content."
  },
  "paths": {
    "/api/v1/personal-listing-drafts": {
      "post": {
        "operationId": "createPersonalListingDraft",
        "summary": "Create a private draft in the current user's personal drafting workspace",
        "description": "First use atomically initializes a person-owned workspace, active membership and exactly five scoped grants. Reuse never restores removed grants or revoked membership. Owner/actor are resolved from the current session. Receipt scope is user plus personal-create operation plus command_id.",
        "security": [
          {
            "SessionCookie": [],
            "CSRFProof": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must match the configured HTTPS public origin exactly. The authenticated cookie alone cannot authorize a mutation."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraft"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized replay of the same normalized creation command; immutable initial IDs and versions with replayed=true. Use GET for current fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedDraft"
                }
              }
            }
          },
          "201": {
            "description": "Created atomically. Returned versions describe the original creation outcome, not a cached current resource.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedDraft"
                }
              }
            }
          },
          "400": {
            "description": "Stable error code and server-generated request ID; no protected resource or credential details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Stable error code and server-generated request ID; no protected resource or credential details.",
            "content": {
